# ============================================================
# Seven Heaven Cosmetics — Environment Template
# Copy this to `.env` and fill real values.
# ============================================================

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sevenheaven_db?retryWrites=true&w=majority

# Server API
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES=7d
ADMIN_EMAIL=sevenheavencosmetics@gmail.com
ADMIN_PASSWORD=your_admin_password_here

# Razorpay (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Configuration -> Webhooks -> secret (same value as here)
# Webhook URL: https://sevenheaven.co.in/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Server runtime
NODE_ENV=development
ADMIN_ROUTE_PREFIX=/api/v1/sh7-control-panel

# Frontend (Vite)
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=
